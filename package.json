{
  "name": "@falcondev-oss/expo-event-source-polyfill",
  "type": "module",
  "version": "2.1.0",
  "description": "A polyfill for the EventSource API in Expo using `expo/fetch`",
  "license": "Apache-2.0",
  "repository": "github:falcondev-oss/expo-event-source-polyfill",
  "bugs": {
    "url": "https://github.com/falcondev-oss/expo-event-source-polyfill/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "eventsource",
    "polyfill",
    "sse",
    "server-sent-events",
    "typescript"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "src/index.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --cache . && prettier --check --cache .",
    "lint:ci": "eslint --cache --cache-strategy content . && prettier --check --cache --cache-strategy content .",
    "lint:fix": "eslint --fix --cache . && prettier --write --cache .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo": ">=52"
  },
  "devDependencies": {
    "@falcondev-oss/configs": "^6.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "changelogithub": {
    "extends": "gh:falcondev-it/configs/changelogithub"
  }
}
